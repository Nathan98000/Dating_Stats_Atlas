# The Oracle VM's one public surface (compose.yaml, docs/deploy.md Topology
# C): HTTPS for the site's address, with a certificate Caddy obtains and
# renews itself, and every request passed to the web app over the private
# network. No access log is configured, so no visit is recorded. Responses
# are compressed for clients that accept it: /api/rank's JSON is about 1.5MB
# raw and about 230KB gzipped, and Next compresses only its HTML.
# Phase 6 (F03): the photographs, their sized copies and the link-preview
# images keep their names when unchanged, so a browser may reuse them for a
# week instead of asking again on every view (Next serves public files with
# max-age=0; ">" replaces the proxied header after the app answers).

# No record of a visit in Caddy's own log either (2026-10-11). When a visitor
# cuts a page short, the reverse proxy warns "aborting with incomplete
# response" with the request (the visitor's address, browser and page) and
# an error that names the visitor's address ("write tcp ...->[ip]:port").
# The filter drops the request from every line and masks any IP address in
# the error, so the warning keeps only what failed and when.
{
	log {
		format filter {
			wrap json
			fields {
				request delete
				error regexp "(\d{1,3}\.){3}\d{1,3}|\[[0-9A-Fa-f:.%]+\]" "[ip]"
			}
		}
	}
}

# Phase 7 (R12, Nathan's decision of 13 October 2026): security headers on
# the site's address. HSTS for a year, without "preload" (a one-way choice
# left to Nathan); no sniffing of content types; no camera, microphone,
# location or interest cohort; and a Content-Security-Policy that lets a
# page load only what comes from the site itself (Next's inline scripts and
# style attributes need 'unsafe-inline'), so the Privacy page's "no page
# loads anything from another company's servers" is enforced by the browser.
# Referrer-Policy stays where it is, in web/next.config.ts, so it isn't sent
# twice. Checked through web/scripts/review/csp_proxy.mjs before deploying.
{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	@photos path /cities/* /stats/* /og/*
	header @photos >Cache-Control "public, max-age=604800"
	reverse_proxy web:3000
}

# www and the site's earlier addresses (2026-10-11: datingscenedata.com is
# the address; before it, the DuckDNS name of the rename to Dating Scene
# Data, and before that Dating Stats Atlas's): every request is sent, path
# and query intact, to the same page at the site's address with a permanent
# redirect, so links shared before still arrive. Caddy keeps a certificate
# for each name, so the DuckDNS names stay claimed and pointed at the VM.
{$REDIRECT_ADDRESSES} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
