# The Oracle VM's one public surface (compose.yaml, docs/deploy.md Topology
# C): HTTPS for the site's address, with a certificate Caddy obtains and
# renews itself, and every request passed to the web app over the private
# network. No access log is configured, so no visit is recorded. Responses
# are compressed for clients that accept it: /api/rank's JSON is about 1.5MB
# raw and about 230KB gzipped, and Next compresses only its HTML.
# Phase 6 (F03): the photographs, their sized copies and the link-preview
# images keep their names when unchanged, so a browser may reuse them for a
# week instead of asking again on every view (Next serves public files with
# max-age=0; ">" replaces the proxied header after the app answers).

# No record of a visit in Caddy's own log either (2026-10-11). When a visitor
# cuts a page short, the reverse proxy warns "aborting with incomplete
# response" with the request (the visitor's address, browser and page) and
# an error that names the visitor's address ("write tcp ...->[ip]:port").
# The filter drops the request from every line and masks any IP address in
# the error, so the warning keeps only what failed and when.
{
	log {
		format filter {
			wrap json
			fields {
				request delete
				error regexp "(\d{1,3}\.){3}\d{1,3}|\[[0-9A-Fa-f:.%]+\]" "[ip]"
			}
		}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	@photos path /cities/* /stats/* /og/*
	header @photos >Cache-Control "public, max-age=604800"
	reverse_proxy web:3000
}

# The site's first address, from before its rename to Dating Scene Data
# (2026-10-10): every request is sent, path and query intact, to the same
# page at the new address with a permanent redirect, so links shared before
# the rename still arrive. Caddy keeps a certificate for this name too, so
# the DuckDNS name stays claimed and pointed at the VM.
{$OLD_SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
